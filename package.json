{
  "name": "@datadog/datadog-backstage-plugins",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "config:check": "backstage-cli config:check --strict",
    "prettier:check": "prettier --check .",
    "deprecations": "backstage-cli repo list-deprecations",
    "spellcheck": "cspell --gitignore '**/*.{tsx,ts,yaml,md}'",
    "verify": "yarn clean && yarn spellcheck --no-progress && yarn lint:all && yarn config:check && yarn tsc && yarn deprecations && yarn test:all && yarn knip && yarn clean && echo '💙 - verified - 💙'",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.5",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.4",
    "cspell": "^9.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest-canvas-mock": "^2.5.2",
    "knip": "^5.73.4",
    "node-gyp": "^12.1.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "isolated-vm": ">=6",
    "jsonpath-plus": ">=10",
    "koa": ">=2",
    "tough-cookie": ">=4",
    "axios@npm:^1.0.0": "npm:^1.19.0",
    "axios@npm:^1.7.4": "npm:^1.19.0",
    "tar@npm:^7.4.3": "npm:^7.5.22",
    "protobufjs@npm:^7.0.0": "npm:^7.6.5",
    "protobufjs@npm:^7.2.5": "npm:^7.6.5",
    "protobufjs@npm:^7.2.6": "npm:^7.6.5",
    "protobufjs@npm:^7.3.2": "npm:^7.6.5",
    "protobufjs@npm:^7.4.0": "npm:^7.6.5",
    "undici@npm:^7.2.3": "npm:^7.29.0",
    "dompurify@npm:=3.2.6": "npm:^3.4.13",
    "dompurify@npm:^3.2.6": "npm:^3.4.13",
    "handlebars@npm:^4.7.3": "npm:^4.7.9",
    "fast-xml-parser@npm:5.2.5": "npm:^5.10.1",
    "fast-xml-parser@npm:^5.0.7": "npm:^5.10.1",
    "node-forge@npm:^1": "npm:^1.4.0",
    "node-forge@npm:^1.2.1": "npm:^1.4.0",
    "node-forge@npm:^1.3.1": "npm:^1.4.0",
    "fast-xml-parser@npm:^4.4.1": "npm:^4.5.7",
    "fast-xml-parser@npm:^4.5.0": "npm:^4.5.7",
    "basic-ftp@npm:^5.0.2": "npm:^5.3.1",
    "fast-uri@npm:^3.0.1": "npm:^3.1.5",
    "multer@npm:^2.0.2": "npm:^2.2.0",
    "shell-quote@npm:^1.7.3": "npm:^1.10.0",
    "shell-quote@npm:^1.8.3": "npm:^1.10.0",
    "websocket-driver@npm:>=0.5.1": "npm:>=0.7.5",
    "websocket-driver@npm:^0.7.4": "npm:>=0.7.5"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "setupFiles": [
      "jest-canvas-mock"
    ]
  },
  "packageManager": "yarn@4.10.3"
}
